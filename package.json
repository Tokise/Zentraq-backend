{
  "name": "@zentraq/backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm --filter=!@zentraq/backend -r build",
    "dev": "node scripts/dev.mjs",
    "dev:legacy": "node scripts/dev.mjs --legacy",
    "lint": "eslint .",
    "test": "pnpm --filter @zentraq/shared build && pnpm --filter=!@zentraq/backend -r test",
    "typecheck": "pnpm --filter @zentraq/shared build && pnpm --filter=!@zentraq/backend --filter=!@zentraq/shared -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.1",
    "supertest": "7.2.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "workspaces": ["services/*", "packages/*"]
}
