SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-project-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
SUPABASE_EDGE_FUNCTIONS_URL=https://your-project-ref.supabase.co/functions/v1

EDGE_GATEWAY_HMAC_SECRET=replace-with-a-random-32-character-edge-signing-secret
INTERNAL_SERVICE_KEY=replace-with-a-random-32-character-service-key
INTERNAL_CONTEXT_SECRET=replace-with-a-random-32-character-context-signing-secret

ALLOWED_ORIGINS=http://localhost:3000
APPOINTMENT_SERVICE_URL=http://localhost:4003
INVENTORY_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005
REPORTING_SERVICE_URL=http://localhost:4006
AI_SERVICE_URL=http://localhost:4007
SERVICE_TIMEOUT_MS=65000

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
