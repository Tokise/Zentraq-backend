# Supabase Auth remains in the frontend.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only URL used by Next.js Server Actions.
BACKEND_URL=http://localhost:4000

# Never add Supabase secret keys or Render internal secrets here.
