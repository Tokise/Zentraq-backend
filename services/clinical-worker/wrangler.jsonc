{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zentraq-clinical",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "clinical.tokise.pw",
      "custom_domain": true,
      "zone_name": "tokise.pw",
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
