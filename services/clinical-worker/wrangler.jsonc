{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zentraq-clinical",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Bindings are defined per environment; secrets are set via `wrangler secret put`.
  // Local development uses `.dev.vars` for secrets.
  "vars": {
    "ENVIRONMENT": "production"
  }

  // Custom domain routing — configured after first deploy:
  // routes = [{ pattern = "clinical-api.tokise.pw/*", custom_domain = true }]
  //
  // For initial testing, the Worker will be available at:
  // https://zentraq-clinical.<your-account>.workers.dev
}
